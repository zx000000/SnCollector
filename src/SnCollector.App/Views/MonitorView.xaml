<UserControl x:Class="SnCollector.App.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <UniformGrid Columns="4" Margin="0,0,0,10">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="连接状态" Style="{StaticResource FieldLabel}"/>
                        <TextBlock FontSize="16" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="○ 未连接"/>
                                    <Setter Property="Foreground" Value="#EF4444"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Text" Value="● 已连接"/>
                                            <Setter Property="Foreground" Value="#22C55E"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="服务器地址" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding PlcAddress}" FontSize="14" FontWeight="Bold" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="今日接收" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding TodayCount}" FontSize="18" FontWeight="Bold" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="累计接收" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding TotalCount}" FontSize="18" FontWeight="Bold" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}">
                <WrapPanel>
                    <TextBlock Margin="0,0,24,0"><Run Foreground="#64748B" Text="启动时间 "/><Run x:Name="BootTime"/></TextBlock>
                    <TextBlock Margin="0,0,24,0"><Run Foreground="#64748B" Text="连续运行 "/><Run Text="{Binding UpTime}" FontFamily="Consolas"/></TextBlock>
                    <TextBlock Margin="0,0,24,0"><Run Foreground="#64748B" Text="最后接收 "/><Run Text="{Binding LastReceive}" FontFamily="Consolas"/></TextBlock>
                    <TextBlock Margin="0,0,24,0" Foreground="#DC2626" Text="{Binding LastError}"
                               Visibility="{Binding LastError, Converter={StaticResource StringToVisibility}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding StartStopCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Content" Value="开始采集"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Content" Value="停止采集"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="接收数据" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <Button Content="暂停" Command="{Binding TogglePauseCommand}" Margin="0,0,8,0"/>
                            <Button Content="清空列表" Command="{Binding ClearCommand}"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding RecordsView}" Height="380"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
