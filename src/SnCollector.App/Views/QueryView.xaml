<UserControl x:Class="SnCollector.App.Views.QueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="查询条件" Style="{StaticResource CardTitle}"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,0" MinWidth="170">
                            <TextBlock Text="开始日期" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding From}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0" MinWidth="170">
                            <TextBlock Text="结束日期" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding To}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0" MinWidth="170">
                            <TextBlock Text="关键字" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0" MinWidth="130">
                            <TextBlock Text="结果" Style="{StaticResource FieldLabel}"/>
                            <ComboBox SelectedIndex="{Binding ResultFilterIndex}">
                                <ComboBoxItem Content="全部"/>
                                <ComboBoxItem Content="正常"/>
                                <ComboBoxItem Content="异常"/>
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="查询" Command="{Binding QueryCommand}" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="重置" Command="{Binding ResetCommand}"/>
                        <Button Content="导出 CSV" Command="{Binding ExportCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="查询结果" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ResultInfo}" Foreground="#64748B" FontSize="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding ResultsView}" Height="420"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
