<UserControl x:Class="SnCollector.App.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:models="clr-namespace:SnCollector.Core.Models;assembly=SnCollector.Core">
    <UserControl.Resources>
        <!-- 数据类型下拉框的数据源：直接取枚举值，不依赖视觉树（DataGridColumn 不在视觉树中，RelativeSource 绑定会失败） -->
        <ObjectDataProvider x:Key="DataItemTypes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:DataItemType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <Border Style="{StaticResource Card}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="采集协议" Style="{StaticResource CardTitle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox ItemsSource="{Binding ProtocolChoices}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedProtocol}" Width="180" Margin="0"/>
                    <TextBlock Text="切换协议后需重启应用生效" FontSize="11" Foreground="#64748B"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </Border>
            <UniformGrid Columns="2">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0"
                        Visibility="{Binding IsFins, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="通讯参数" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="PLC IP 地址" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding PlcIp}"/>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="PLC 端口" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding PlcPort}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="本机端口" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding LocalPort}"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="超时时间 (ms)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Timeout}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0"
                        Visibility="{Binding IsOpcUa, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="OPC UA 连接参数" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="服务器 Endpoint" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding OpcEndpoint}"/>
                        <TextBlock Text="安全策略" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding SecurityPolicyOptions}" SelectedItem="{Binding OpcSecurityPolicy}"/>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="用户名（匿名留空）" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding OpcUsername}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding OpcPassword}"/>
                            </StackPanel>
                        </UniformGrid>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="发布间隔 (ms)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding OpcPublishInterval}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="采样间隔 (ms)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding OpcSamplingInterval}"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="密码明文保存在本地配置文件中，请注意保管" FontSize="11" Foreground="#64748B" Margin="0,-4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="触发设置" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="触发接收通讯地址" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding TriggerAddress}"/>
                        <TextBlock Text="FINS 填位地址（如 D100.00）；OPC UA 填触发节点的 NodeId（如 ns=2;s=Trigger）" FontSize="11" Foreground="#64748B" Margin="0,-4,0,8" TextWrapping="Wrap"/>
                        <StackPanel Visibility="{Binding IsFins, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="轮询间隔 (ms)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding PollInterval}"/>
                        </StackPanel>
                        <CheckBox Content="读取完成后自动复位触发位" IsChecked="{Binding AutoReset}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="界面设置" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="实时列表最大行数" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding MaxListRows}"/>
                        <TextBlock Text="1~2000，默认 200；超出后自动删除最旧行，历史数据不受影响" FontSize="11" Foreground="#64748B" Margin="0,-4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="数据项配置" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                        <Button Content="+ 添加数据项" Command="{Binding AddItemCommand}"
                                HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                    </DockPanel>
                    <!-- IsReadOnly=False 覆盖 App.xaml 中 DataGrid 全局样式的只读设置（监视页不受影响） -->
                    <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False" Height="220" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="数据项名称" Binding="{Binding Name}" Width="*"/>
                            <DataGridComboBoxColumn Header="数据类型" Width="110"
                                SelectedItemBinding="{Binding DataType}"
                                ItemsSource="{Binding Source={StaticResource DataItemTypes}}"/>
                            <DataGridTextColumn Header="起始地址" Binding="{Binding Address}" Width="110"/>
                            <DataGridTextColumn Header="长度(字)" Binding="{Binding LengthWords}" Width="90"/>
                            <DataGridTemplateColumn Header="操作" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="删除" Padding="8,3"
                                            Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="起始地址：FINS 填 DM 区地址（如 D200）；OPC UA 填节点 NodeId（如 ns=2;s=SN1）。扩展数据项（批次号、工位、NG 代码等）只需加一行并保存，无需改代码。"
                               FontSize="11" Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Content="保存配置" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/>
                <Button Content="恢复默认" Command="{Binding ResetDefaultCommand}"/>
                <Button Content="测试连接" Command="{Binding TestConnectionCommand}"/>
            </StackPanel>
            <TextBlock Text="配置保存在本机（%AppData%/SnCollector/config.json），下次启动自动加载。"
                       FontSize="11" Foreground="#64748B" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
