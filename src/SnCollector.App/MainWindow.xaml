<Window x:Class="SnCollector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SnCollector.App.Views"
        Title="SN 数据采集终端" Height="740" Width="1100"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1E293B" Padding="12,8">
            <DockPanel>
                <TextBlock Text="SN 数据采集终端" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="OMRON FINS · UDP" Foreground="#94A3B8" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <TabControl x:Name="MainTabs" Margin="4">
            <TabItem Header="运行监视">
                <views:MonitorView x:Name="MonitorViewControl"/>
            </TabItem>
            <TabItem Header="历史查询">
                <views:QueryView x:Name="QueryViewControl"/>
            </TabItem>
            <TabItem Header="参数配置">
                <views:ConfigView x:Name="ConfigViewControl"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
